rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection ping testing
    match /test/{docId} {
      allow read, write: if true;
    }
    match /connection_test/{docId} {
      allow read, write: if true;
    }

    // Admins collection: Protected to authenticated personnel only
    match /admins/{adminId} {
      allow read, write: if request.auth != null;
    }

    // Reports collection: Strict Citizen Privacy Protection
    // Public intake is WRITE-ONLY (blind intake). Zero public read/list permissions.
    // Absolutely NO unauthorized user can read, list, update, or delete sensitive personal data.
    match /reports/{reportId} {
      // Citizen intake allows creation only
      allow create: if true;
      // Strict authorization: Only verified PNP officers can read, update, or delete records
      allow read, update, delete: if request.auth != null;
    }
  }
}
