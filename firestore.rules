rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all deny for maximum zero-trust security
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection: Protected strictly to the unique trusted ADMIN_UID or official admin email
    match /admins/{adminId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == 'RbisRuyOLEbena1ncWe2xk8HTzy2' || 
        request.auth.token.email == 'bauan.pnp.investigation@gmail.com'
      );
    }

    // Reports collection:
    // - Public citizens can submit/create new personal intake reports.
    // - Reading, searching, updating, and deleting records is restricted strictly to authorized police personnel.
    match /reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && (
        request.auth.uid == 'RbisRuyOLEbena1ncWe2xk8HTzy2' || 
        request.auth.token.email == 'bauan.pnp.investigation@gmail.com'
      );
    }
  }
}
