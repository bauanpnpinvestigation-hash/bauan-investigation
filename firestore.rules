rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default catch-all deny for maximum zero-trust security
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection: Protected strictly to the unique trusted ADMIN_UID or official admin email
    match /admins/{adminId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == 'RbisRuyOLEbena1ncWe2xk8HTzy2' || 
        request.auth.token.email == 'bauan.pnp.investigation@gmail.com'
      );
    }

    // Reports collection: Only the official trusted ADMIN_UID or verified admin email has permission
    match /reports/{reportId} {
      allow read, write: if request.auth != null && (
        request.auth.uid == 'RbisRuyOLEbena1ncWe2xk8HTzy2' || 
        request.auth.token.email == 'bauan.pnp.investigation@gmail.com'
      );
    }
  }
}
